# Database
DATABASE_URL="postgresql://priceapp:changeme@postgres:5432/pricedb"

# App
NEXT_PUBLIC_APP_URL="https://prices.wetpaws.dev"
# Password for the web UI login gate + API key auth.
# In production, all pages require this password to access.
# In development (no NODE_ENV=production), auth is bypassed for convenience.
APP_SECRET="change-this-to-a-random-secret"

# Resend (email receiving)
# Set up an inbound email route in Resend dashboard pointing to:
#   POST /api/receipts/email
# and add the webhook signing secret here
RESEND_WEBHOOK_SECRET=""

# AI provider — set one or both for AI-powered features:
#   - Receipt image OCR (photo → structured items)
#   - Product name normalization (messy receipt text → clean names)
# Prefers Claude if both are set. Leave blank to use free Tesseract OCR.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional: Scraper config (leave blank to disable)
# Oxylabs or Bright Data proxy for scraping without blocks
SCRAPER_PROXY_URL=""
